<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8"/>
    <title>{{with .Data}}{{.Title}}{{end}}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <style>
        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #f4f4f4;
            margin: 0;
            padding: 20px;
        }

        .container {
            max-width: 600px;
            margin: 0 auto;
            background: #fff;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 2px 4px rgba(0, 0, 0, .1);
        }

        .header {
            color: #fff;
            padding: 20px;
            text-align: center;
        }

        .content {
            padding: 24px;
            color: #111827;
        }

        .hint {
            color: #64748b;
            font-size: 13px;
        }

        .code {
            display: flex;
            justify-content: center;
            margin: 12px 0;
        }

        .code span {
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
            font-size: 32px;
            font-weight: 700;
            letter-spacing: 8px;
            color: #111827;
            background: #f1f5f9;
            border: 1px dashed #94a3b8;
            border-radius: 10px;
            padding: 12px 16px;
        }
    </style>
    <meta http-equiv="Content-Security-Policy" content="default-src 'none'; img-src data:; style-src 'unsafe-inline';"/>
    <meta name="color-scheme" content="light only"/>
</head>
<body>
<div class="container">
    <div class="header"
         style="background:#2563eb;">
        {{template "header" .Data}}
    </div>
    <div class="content">
        {{.Content}}
    </div>
    <div class="footer" style="padding:16px 24px;color:#94a3b8;font-size:12px;">
        {{template "footer" .Data}}
    </div>
</div>
</body>
</html>
